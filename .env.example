# Server-only Brevo credentials used by `/api/waitlist`.
# Never expose them with a NEXT_PUBLIC_ prefix.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=

# Payload admin (Postgres). Use a pooled Postgres URL on Vercel.
DATABASE_URI=
# A long random value. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=
# Vercel Blob read/write token for media uploads.
BLOB_READ_WRITE_TOKEN=

# Optional. Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically and the app
# uses it for canonical/OG metadata. Set this only for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://aika.example.com
